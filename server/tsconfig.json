{
  "extends": ["@tsconfig/node22/tsconfig.json", "../tsconfig.base.json"],
  "compilerOptions": {
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../packages/shared" }
  ]
}
